<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>NvGraphics</AssemblyName>
    <RootNamespace>NvGraphics</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x64</Platforms>
    <Product>NVIDIA ShadowPlay</Product>
    <AssemblyTitle>NvGraphics</AssemblyTitle>
    <!-- Isolated output — does not touch any existing application binary. -->
    <OutputPath>..\..\..\build\NVIDIA ShadowPlay\NvGraphics\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationIcon>NVIDIA ShadowPlay.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="NVIDIA ShadowPlay.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.183" PrivateAssets="all" />
    <ProjectReference Include="..\NvGraphics.Contracts\NvGraphics.Contracts.csproj" />
  </ItemGroup>

</Project>
