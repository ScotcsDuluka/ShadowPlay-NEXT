<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>CaptureEngine.FFmpegBackend</AssemblyName>
    <Description>CaptureEngine.FFmpegBackend — FFmpeg full-pipeline execution backend (P1-C)</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CaptureEngine.dll\CaptureEngine.vbproj" />
    <ProjectReference Include="..\CaptureEngine.Audio.Wasapi.dll\CaptureEngine.Audio.Wasapi.csproj" />
  </ItemGroup>

</Project>
