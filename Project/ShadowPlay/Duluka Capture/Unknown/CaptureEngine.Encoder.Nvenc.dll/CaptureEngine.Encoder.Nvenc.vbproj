<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <!-- net10.0-windows because Vortice packages (D3D11 + DXGI) require it
         and we use ID3D11Texture2D + D3D11 device types in NvencEncoderBackend. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>CaptureEngine.Encoder.Nvenc</AssemblyName>
    <Description>CaptureEngine.Encoder.Nvenc — IEncoderBackend implementation using NVIDIA NVENC via D3D11 (Phase 12a-3)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Foundation encoder contract — provides IEncoderBackend, EncoderConfig,
         EncodedPacket, PacketMetadata, EncoderState, IEncoderDiagnostics. -->
    <ProjectReference Include="..\CaptureEngine.Encoder.dll\CaptureEngine.Encoder.vbproj" />
    <!-- Video contract — provides IVideoFrame + ID3D11VideoFrame (Phase 12 extension). -->
    <ProjectReference Include="..\CaptureEngine.Video.dll\CaptureEngine.Video.vbproj" />
    <!-- Foundation — provides EngineLogger. -->
    <ProjectReference Include="..\CaptureEngine.dll\CaptureEngine.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vortice for D3D11 device + texture + context + COM marshalling.
         Version matches Ddagrab + spike for ABI consistency (3.6.2). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

</Project>
