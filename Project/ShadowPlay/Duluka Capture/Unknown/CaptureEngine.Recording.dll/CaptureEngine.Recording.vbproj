<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>CaptureEngine.Recording</AssemblyName>
    <Description>CaptureEngine.Recording — Phase 12a-5 orchestration (RecordingEngine + CaptureSession)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Foundation -->
    <ProjectReference Include="..\CaptureEngine.dll\CaptureEngine.vbproj" />
    <!-- Video contract + ID3D11VideoFrame -->
    <ProjectReference Include="..\CaptureEngine.Video.dll\CaptureEngine.Video.vbproj" />
    <!-- DdagrabBackend (video capture) -->
    <ProjectReference Include="..\CaptureEngine.Video.Ddagrab.dll\CaptureEngine.Video.Ddagrab.vbproj" />
    <!-- Encoder contract (IEncoderBackend + EncodedPacket) -->
    <ProjectReference Include="..\CaptureEngine.Encoder.dll\CaptureEngine.Encoder.vbproj" />
    <!-- NvencEncoderBackend (H.264 encoding) -->
    <ProjectReference Include="..\CaptureEngine.Encoder.Nvenc.dll\CaptureEngine.Encoder.Nvenc.vbproj" />
    <!-- FFmpeg stack (MuxCoordinator + FFmpegProcessHost) -->
    <ProjectReference Include="..\CaptureEngine.FFmpegBackend.dll\CaptureEngine.FFmpegBackend.vbproj" />
    <!-- Shared Audio Engine: one audio owner for every video engine -->
    <ProjectReference Include="..\CaptureEngine.Audio.dll\CaptureEngine.Audio.csproj" />
    <!-- Low-level WASAPI driver remains an implementation dependency -->
    <ProjectReference Include="..\CaptureEngine.Audio.Wasapi.dll\CaptureEngine.Audio.Wasapi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NAudio for WASAPI loopback audio capture (same as spike Phase 10) -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
  </ItemGroup>

</Project>
