<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CaptureEngine.Recording.ConsoleDriver</RootNamespace>
    <AssemblyName>CaptureEngine.Recording.ConsoleDriver</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Description>CaptureEngine.Recording.ConsoleDriver — Phase 12a-5 orchestration test (2-session MP4 lifecycle)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Recording orchestration (transitively pulls in all backends) -->
    <ProjectReference Include="..\CaptureEngine.Recording.dll\CaptureEngine.Recording.vbproj" />
    <!-- Foundation (for EngineLogger — used directly in Program.vb) -->
    <ProjectReference Include="..\CaptureEngine.dll\CaptureEngine.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PHASE 1 VIDEO VALIDATION (videocheck mode): the canonical config
         chain, LINKED (not copied) — same source the Engine compiles on
         Windows, same composition Engine.ConfigTruth.Tests executes on
         Linux. The Engine form itself stays out of scope by design.
         The [ ] folder names are literal for MSBuild (no globbing). -->
    <Compile Include="..\..\..\..\..\Common\AppLayout.vb" Link="AppLayout.vb" />
    <Compile Include="..\..\..\..\..\Common\FFmpegLocator.vb" Link="FFmpegLocator.vb" />
    <Compile Include="..\..\..\NvCapture\ShadowPlay\%5BCapture%5D\CaptureSettings.vb" Link="CaptureSettings.vb" />
    <Compile Include="..\..\..\NvCapture\ShadowPlay\%5BIntegration%5D\OverlayConfig.vb" Link="OverlayConfig.vb" />
    <Compile Include="..\..\..\NvCapture\ShadowPlay\%5BAPI%5D\NextRecordingConfig.vb" Link="NextRecordingConfig.vb" />
    <!-- The single preset mapper lives in the foundation's ConfigMigrator. -->
    <Compile Include="..\CaptureEngine.dll\Configuration\ConfigMigrator.vb" Link="ConfigMigrator.vb" />
    <Compile Include="..\CaptureEngine.dll\Configuration\EngineConfigV2.vb" Link="EngineConfigV2.vb" />
  </ItemGroup>

  <ItemGroup>
    <!-- VB project-level namespace imports for the linked Engine files
         (CaptureSettings.vb:464 probes Screen.PrimaryScreen — real
         WinForms on net10.0-windows, no shim needed). -->
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Drawing" />
    <Import Include="System.Linq" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
