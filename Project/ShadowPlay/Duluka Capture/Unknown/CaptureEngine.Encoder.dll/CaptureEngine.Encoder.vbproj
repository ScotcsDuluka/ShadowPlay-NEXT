<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>CaptureEngine.Encoder</AssemblyName>
    <Description>CaptureEngine.Encoder — P1-F video encoder subsystem (contract + FakeEncoderBackend; no NVENC/D3D11/DXGI/FFmpeg)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CaptureEngine.Encoder depends on:
        - CaptureEngine.Video  (for IVideoFrame input contract — Phase 1 BGRA8 frames)
        - CaptureEngine        (for EngineLogger — same structured-logger pattern as DdagrabBackend)

      It does NOT depend on:
        - FFmpeg / NAudio / WinForms / Win32 / D3D11 / DXGI / NVENC
        - Any legacy Engine/ project
        - Any UI / Overlay / Config V2 module
        - Any concrete capture backend (DdagrabBackend, FakeVideoCaptureBackend)

      The encoder is intentionally a pure contract + value-type foundation.
      Concrete encoder implementations (NvencEncoder, QsvEncoder, AmfEncoder,
      SoftwareEncoder) live in SEPARATE future projects and depend on THIS
      contract. They MUST NOT be added to this assembly.

      P1-F-NVENC (owned by GLM/4) is a separate task that will create the
      NvencEncoder concrete implementation. This contract must NOT leak
      NVENC-specific types (no nvEncodeAPI, no NV_ENC_*, no DllImport).
    -->
    <ProjectReference Include="..\CaptureEngine.Video.dll\CaptureEngine.Video.vbproj" />
    <ProjectReference Include="..\CaptureEngine.dll\CaptureEngine.vbproj" />
  </ItemGroup>

</Project>
