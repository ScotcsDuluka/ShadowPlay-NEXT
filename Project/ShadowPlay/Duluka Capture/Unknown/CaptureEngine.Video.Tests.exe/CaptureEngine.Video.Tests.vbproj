<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>CaptureEngine.Video.Tests</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Description>CaptureEngine.Video contract tests — P1-B.1 (FakeVideoCaptureBackend; no xUnit/NUnit)</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CaptureEngine.Video.dll\CaptureEngine.Video.vbproj" />
    <ProjectReference Include="..\CaptureEngine.dll\CaptureEngine.vbproj" />
    <ProjectReference Include="..\CaptureEngine.Video.Ddagrab.dll\CaptureEngine.Video.Ddagrab.vbproj" />
  </ItemGroup>
</Project>
