<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 ON PURPOSE: FFmpegTests (Linux CI, synthetic positions)
         targets net10.0 and must reference this project. Pure [ComImport]
         interop COMPILES cross-platform; the WASAPI runtime path is guarded
         by WasapiPositionCapture.Start() (Windows-only, throws elsewhere). -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>CaptureEngine.Audio.Wasapi</RootNamespace>
    <AssemblyName>CaptureEngine.Audio.Wasapi</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Description>CaptureEngine.Audio.Wasapi — P13.2 position-aware WASAPI capture (direct COM interop, zero deps)</Description>
    <!-- CA1416: the COM surface IS Windows-only by design; the runtime
         entry (WasapiPositionCapture.Start) guards with IsWindowsPlatform
         and the pure logic (AudioPositionTracker) is platform-free.
         Keeping the interop file byte-identical to the P13.1 spike beats
         spraying attributes over proven code. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
