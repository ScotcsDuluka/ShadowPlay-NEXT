<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>CaptureEngine.Tests</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Description>CaptureEngine Foundation lifecycle tests — Task 001 (console runner, no xUnit/NUnit)</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CaptureEngine.dll\CaptureEngine.vbproj" />
  </ItemGroup>
</Project>
