<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console at all; "showConsole": true allocates one -->
    <OutputType>WinExe</OutputType>
    <!-- Managed host for the Project NodeAPI tree. AssemblyName IS the
         production name: the bin produces NVIDIA Web Helper.exe (apphost) +
         NVIDIA Web Helper.dll (body), deployed beside NvNode.exe, index.js,
         and node_modules. Responsibilities: resolve the Project NodeAPI
         runtime from the installed layout, spawn NvNode.exe index.js on
         127.0.0.1:59011,
         duplicate-process guard, stdout/stderr capture, health proof,
         graceful shutdown, no-orphan job. Stays OUTSIDE the NvContainer
         boundary (see the owner note in NvContainer.vbproj); the parity
         surface lives in Backend\ and is NOT duplicated here. Launch
         contract (docs/PHASE-1B-LAUNCH-CONTRACT.md): config = JSON +
         environment only, argv discarded. -->
    <AssemblyName>NVIDIA Web Helper</AssemblyName>
    <RootNamespace>NvBackend</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- OWNER icon mandate: every new executable project uses the canonical
         Overlay icon (single source of truth in Assets\). -->
    <ApplicationIcon>NVIDIA ShadowPlay.ico</ApplicationIcon>
    <AssemblyTitle>NVIDIA Web Helper Services</AssemblyTitle>
    <Product>NVIDIA ShadowPlay</Product>
    <Company>NVIDIA Corporation</Company>
    <Version>3.28.0.412</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\..\NVIDIA Container\NvContainer-Capture\NVIDIA ShadowPlay.ico" Link="NVIDIA ShadowPlay.ico" />
  </ItemGroup>

</Project>
