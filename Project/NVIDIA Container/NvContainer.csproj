<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NvContainer owns NvGraphics.exe, NvCapture.exe, NVIDIA OSC.exe,
         NVIDIA Web Helper.exe, and nvsphelper.exe. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>NvContainer</AssemblyName>
    <RootNamespace>NvContainer</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Assets\NVIDIA ShadowPlay.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- The helper is a separate nested project; its generated obj sources
         must not be globbed into NvContainer during a local build. -->
    <Compile Remove="NVIDIA ShadowPlay Helper/**/*.cs" />
    <!-- Standalone catalog regression runner must not compile into NvContainer.exe. -->
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NVIDIA Graphics\NvGraphics.Contracts\NvGraphics.Contracts.csproj" />
    <ProjectReference Include="..\NVIDIA Graphics\NvGraphics.App\NvGraphics.csproj"
                      AdditionalProperties="OutputPath=..\..\..\build\NvGraphics-ContainerRef\" />
  </ItemGroup>

</Project>
