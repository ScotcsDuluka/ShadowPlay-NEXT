<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>DulukaEngine.ConfigTests</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Description>DulukaEngine EngineConfig v2 migration + validation + round-trip tests — Phase 1 (no xUnit/NUnit)</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\DulukaEngine\DulukaEngine.vbproj" />
  </ItemGroup>
</Project>
