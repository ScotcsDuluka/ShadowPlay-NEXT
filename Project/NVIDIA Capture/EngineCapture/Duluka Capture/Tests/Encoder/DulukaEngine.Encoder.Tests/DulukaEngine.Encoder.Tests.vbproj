<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <AssemblyName>DulukaEngine.Encoder.Tests</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Description>DulukaEngine.Encoder contract tests — P1-F (FakeEncoderBackend; no xUnit/NUnit)</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- PHASE 1 V-CT5: the pure NVENC param builder + its interop struct
         definitions, LINKED so the init-params contract runs on Linux
         (no native NVENC, no D3D11 — System only). -->
    <Compile Include="..\..\..\Encoding\NVENC\DulukaEngine.Encoder.Nvenc\Internal\NvEncodeAPI.vb" Link="NvEncodeAPI.vb" />
    <Compile Include="..\..\..\Encoding\NVENC\DulukaEngine.Encoder.Nvenc\Internal\NvEncParamBuilder.vb" Link="NvEncParamBuilder.vb" />
    <!-- C/6: NvencEncoderBackend + its internals LINKED so the lifecycle
         matrix (state convergence, forbidden transitions, Dispose gates)
         compiles into the Linux-runnable suite. Vortice compiles cross-
         platform; on a machine without D3D11/NVENC the Initialize path
         fails at the device factory and the lifecycle tests assert the
         Faulted convergence instead of the success path. -->
    <Compile Include="..\..\..\Encoding\NVENC\DulukaEngine.Encoder.Nvenc\NvencEncoderBackend.vb" Link="NvencEncoderBackend.vb" />
    <Compile Include="..\..\..\Encoding\NVENC\DulukaEngine.Encoder.Nvenc\Internal\NvEncConfigSerializer.vb" Link="NvEncConfigSerializer.vb" />
    <Compile Include="..\..\..\Encoding\NVENC\DulukaEngine.Encoder.Nvenc\Internal\NvEncFunctionTable.vb" Link="NvEncFunctionTable.vb" />
    <Compile Include="..\..\..\Encoding\NVENC\DulukaEngine.Encoder.Nvenc\Internal\NvencResources.vb" Link="NvencResources.vb" />
    <Compile Include="..\..\..\Encoding\NVENC\DulukaEngine.Encoder.Nvenc\Internal\D3D11DeviceFactory.vb" Link="D3D11DeviceFactory.vb" />
    <ProjectReference Include="..\..\..\Encoding\DulukaEngine.Encoder\DulukaEngine.Encoder.vbproj" />
    <ProjectReference Include="..\..\..\Video\Contracts\DulukaEngine.Video\DulukaEngine.Video.vbproj" />
    <ProjectReference Include="..\..\..\Core\DulukaEngine\DulukaEngine.vbproj" />
  </ItemGroup>
</Project>
