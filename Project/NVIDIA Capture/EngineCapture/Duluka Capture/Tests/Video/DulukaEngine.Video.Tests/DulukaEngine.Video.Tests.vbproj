    <ProjectReference Include="..\..\..\Core\DulukaEngine\DulukaEngine.vbproj" />
    <ProjectReference Include="..\..\..\Video\DXGI Desktop Duplication\DulukaEngine.Video.DXGI\DulukaEngine.Video.DXGI.vbproj" />
  </ItemGroup>
