<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <RootNamespace></RootNamespace>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <!-- Route truth is shared [API] source, mirrored the same way RouteGuard.Tests does. -->
    <Compile Include="../../src/[API]/CaptureBackendRoute.vb" Link="CaptureBackendRoute.vb" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Duluka Capture/Video/Contracts/DulukaEngine.Video/DulukaEngine.Video.vbproj" />
    <ProjectReference Include="../Duluka Capture/Video/DXGI Desktop Duplication/DulukaEngine.Video.DXGI/DulukaEngine.Video.DXGI.vbproj" />
  </ItemGroup>
</Project>
