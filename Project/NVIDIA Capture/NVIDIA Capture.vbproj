<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- OWNER (2026-09-25): engine binary identity stays nvsphelper64.exe
                     (GFE-style capture worker, owned by NvContainer; alias:
                     NVIDIA ShadowPlay Helper). Project FILE name is kept
                     (sln + ProjectReference paths stay stable); AssemblyName
                     drives every output name: exe/dll/deps/runtimeconfig. -->
    <AssemblyName>NvCapture</AssemblyName>
    <RootNamespace>NVIDIA_Capture</RootNamespace>
    <StartupObject>NVIDIA_Capture.My.MyApplication</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- WFO1000: net9+ WinForms designer-serialization analyzer. These
         legacy forms are hand-managed (Designer.vb sets the custom control
         properties at runtime); VS designer round-tripping is not used.
         Runtime behavior is identical. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <OptionExplicit>Off</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <ApplicationIcon>NVIDIA ShadowPlay.ico</ApplicationIcon>
    <UserSecretsId>d88fe301-91c6-4beb-a579-370ec911430c</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="NVIDIA ShadowPlay.ico" />
  </ItemGroup>
  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Drawing" />
    <Import Include="System.IO" />
    <Import Include="System.Linq" />
    <Import Include="System.Net" />
    <Import Include="System.Net.Sockets" />
    <Import Include="System.Text" />
    <Import Include="System.Text.Json" />
    <Import Include="System.Threading" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Windows.Forms" />
    <Import Include="Microsoft.VisualBasic" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Asio" Version="2.3.0" />
    <PackageReference Include="NAudio.Core" Version="2.3.0" />
    <PackageReference Include="NAudio.Midi" Version="2.3.0" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="NAudio.WinForms" Version="2.3.0" />
    <PackageReference Include="NAudio.WinMM" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- The NVENC ProjectReference uses Vortice/SharpGen. Keep this exact
         direct package version aligned with DulukaEngine.Encoder.Nvenc.vbproj
         so runtime dependency selection stays deterministic. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>
  <ItemGroup>
    <None Update="API-Core\ffmpeg.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="API-Core\ffprobe.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Engine\[API]\[Engine] Client.vb">
      <SubType>Form</SubType>
    </Compile>
    <!-- Phase 12b: RecordingEngine integration (auto-globbed by SDK) -->
    <!-- Engine\Engine\[API]\RecordingEngineHost.vb is picked up automatically -->
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <!-- WinForms Designer files: must be DependentUpon parent form + have resx.
                     Without this, SDK auto-glob generates duplicate resource names
                     (NVIDIA_Capture.AudioSettingsForm.resources from BOTH .vb AND .Designer.vb). -->
    <Compile Update="Engine\Engine\[UI]\AudioSettingsForm.Designer.vb">
      <DependentUpon>AudioSettingsForm.vb</DependentUpon>
    </Compile>
    <Compile Update="Engine\Engine\[UI]\UI_Engine.Designer.vb">
      <DependentUpon>UI_Engine.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Engine\Engine\[UI]\AudioSettingsForm.resx">
      <DependentUpon>AudioSettingsForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Engine\Engine\[UI]\UI_Engine.resx">
      <DependentUpon>UI_Engine.vb</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <!-- Phase 12b: RecordingEngine + all transitive dependencies -->
  <ItemGroup><Compile Remove="src\[API]\CaptureMediaInspector.vb" /></ItemGroup>
  <ItemGroup>
    <!-- Always resolve Capture dependencies from their actual projects.
         Cached Release DLLs vary across computers and may lack new contracts. -->
    <ProjectReference Include="EngineCapture\Duluka Capture\Recording\DulukaEngine.Recording\DulukaEngine.Recording.vbproj" />
    <ProjectReference Include="EngineCapture\Duluka Capture\Core\DulukaEngine\DulukaEngine.vbproj" />
    <ProjectReference Include="EngineCapture\Duluka Capture\Video\Contracts\DulukaEngine.Video\DulukaEngine.Video.vbproj" />
    <ProjectReference Include="EngineCapture\Duluka Capture\Encoding\DulukaEngine.Encoder\DulukaEngine.Encoder.vbproj" />
    <ProjectReference Include="EngineCapture\Duluka Capture\Encoding\NVENC\DulukaEngine.Encoder.Nvenc\DulukaEngine.Encoder.Nvenc.vbproj" />
    <ProjectReference Include="EngineCapture\Duluka Capture\Audio\DulukaEngine.Audio\DulukaEngine.Audio.csproj" />
    <ProjectReference Include="EngineCapture\Duluka Capture\Audio\DulukaEngine.Audio.Wasapi\DulukaEngine.Audio.Wasapi.csproj" />
    <ProjectReference Include="EngineCapture\Duluka Capture\Recording\Backends\FFmpeg\DulukaEngine.FFmpegBackend\DulukaEngine.FFmpegBackend.vbproj" />

  </ItemGroup>
  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>
  <!-- Root-fixed layout support (linked shared sources) -->
  <ItemGroup>
    <Compile Include="..\..\Common\AppLayout.vb" Link="AppLayout.vb" />
    <Compile Include="..\..\Common\AppLayoutStartup.vb" Link="AppLayoutStartup.vb" />
    <Compile Include="..\..\Common\FFmpegLocator.vb" Link="FFmpegLocator.vb" />
  </ItemGroup>

  <!-- Duluka Capture is a set of nested, independently built projects.
       Exclude their source and generated resources from this legacy WinForms
       app's SDK recursive globs; each nested project owns its own compilation. -->
  <ItemGroup>
    <Compile Remove="EngineCapture\Duluka Capture\**\*.vb" />
    <Compile Remove="EngineCapture\RouteGuard.Tests\**\*.vb" />
    <Compile Remove="EngineCapture\MediaEvidence.Tests\**\*.vb" />
    <Compile Remove="EngineCapture\Mux.Tests\**\*.vb" />
    <Compile Remove="EngineCapture\SessionRecovery.Tests\**\*.vb" />
    <Compile Remove="EngineCapture\DisplaySelection.Tests\**\*.vb" />
    <Compile Remove="EngineCapture\ExclusiveCapture.Tests\**\*.vb" />
    <!-- Generated files of ANY nested project must never be swept into this
         compilation: a nested obj carries AssemblyInfo attributes that
         duplicate ours. Excluding these generically prevents the whole
         failure class, independent of future folder names. -->
    <Compile Remove="EngineCapture\**\obj\**\*.vb" />
    <Compile Remove="EngineCapture\**\bin\**\*.vb" />
    <EmbeddedResource Remove="EngineCapture\Duluka Capture\**\*.resx" />
    <EmbeddedResource Remove="EngineCapture\**\obj\**\*.resx" />
  </ItemGroup>
</Project>
