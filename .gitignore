Build/Build-Config/version.props

# WebView2 user data (Build.exe runtime)
Build/Build-Config/webview2/

# UI diagnostics log (Build.exe runtime)
Build/Build-Config/ui-log.txt

# versions.props / versions.json = generated by Build.exe (per-project version map)
Build/Build-Config/versions.props
Build/Build-Config/versions.json

# BL-1 C++ lane: generated version header (hand-stamped version.rc keeps defaults as fallback)
Project/NvOverlay/Cef/src/bl1_version.h
Project/Launcher.Cef/src/bl1_version.h

