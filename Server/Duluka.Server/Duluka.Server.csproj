<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Duluka.Server — v0 auth/security slice.
       Scope (C/6 implementation): GitHub OAuth (Authorization Code + PKCE + state),
       opaque device-bound sessions (hashed at rest), device/link revoke,
       rate-limit boundary, secret redaction. NVIDIA provider = reserved stub.
       Deliberately ABSENT in v0: sync endpoints, migration framework,
       provider token persistence (used transiently, then discarded). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Duluka.Server</RootNamespace>
    <AssemblyName>Duluka.Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The /admin operator dashboard ships as a single embedded HTML file
         (no wwwroot, no static-file middleware, no external assets). -->
    <EmbeddedResource Include="Admin\admin.html" />
    <EmbeddedResource Include="Portal\index.html" />
    <EmbeddedResource Include="Portal\app.css" />
    <EmbeddedResource Include="Portal\app.js" />
    <EmbeddedResource Include="Portal\scene.css" />
    <EmbeddedResource Include="Portal\scene.js" />
  </ItemGroup>

</Project>
